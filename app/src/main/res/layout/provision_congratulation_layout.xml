<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/miuix_default_color_surface_low_light">

    <com.sevtinge.hyperceiler.provision.renderengine.RenderViewLayout
        android:id="@+id/render_view_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/content_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <View
            android:id="@+id/space_top"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="18" />

        <RelativeLayout
            android:id="@+id/logo_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="40.0">

            <LinearLayout
                android:id="@+id/logo_image_wrapper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <!--
                  与开场页同一套品牌替换：90dp 这一格是 AppIconText 文字标记（在 Java 里设置），
                  另一个槽位是应用名。上游这两个是它的 vector，文件仍留在 drawable 里。
                  这一页用深色（它的 provision_complete_title_color，与下面 system_state_text 同色系），
                  因为这一页的极光没有开场遮罩、是亮的 —— 上游这里也用的 _lite 深色稿。
                -->
                <TextView
                    android:id="@+id/logo_image"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:layout_gravity="center"
                    android:autoSizeMaxTextSize="34sp"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/provision_complete_title_color" />

                <TextView
                    android:id="@+id/text_logo_image"
                    android:layout_width="@dimen/provision_startup_logo_width_thirteen"
                    android:layout_height="@dimen/provision_startup_logo_height_thirteen"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="@string/app_name"
                    android:textColor="@color/provision_complete_title_color"
                    android:textSize="@dimen/provision_title_text_size" />

                <TextView
                    android:id="@+id/system_state_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:fontFamily="mipro-regular"
                    android:textColor="#BF000000"
                    android:textSize="24sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/next_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="44dp"
                android:paddingHorizontal="20dp">

                <FrameLayout
                    android:id="@id/next"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_gravity="center_horizontal"
                    android:maxWidth="336dp">

                    <View
                        android:id="@+id/btn_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/provision_next_btn_background" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/provision_complete_text"
                        android:textColor="#FFFFFFFF"
                        android:textSize="17dp" />
                </FrameLayout>
            </FrameLayout>
        </RelativeLayout>

        <View
            android:id="@+id/space_bottom"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.2" />

    </LinearLayout>
</FrameLayout>
