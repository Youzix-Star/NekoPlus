<!--
  HyperCeiler's permission page lists four of its own checks. This port keeps the page, its
  scrolling container, its paddings and its rows exactly as they are, and lists the two
  permissions this app asks for instead; the note that introduces them ("you can set these later")
  leads the list rather than sitting after the first row, because here neither row is a
  prerequisite for the next button. Its 13sp override is gone so the line uses its own style's size
  (miuix_appcompat_secondary_text_size, 14sp) — the same secondary size the AI page's row summaries
  and the two aurora pages' sub-lines use — and its 16dp top margin is now 8dp, which is what the AI
  page's category header uses, so both pages' first row lands at the same height (7dp list inset +
  8dp + 14sp line + 8dp ≈ 42dp, against the AI page's 7.27dp + 8dp + 14sp + 8dp ≈ 42.3dp).
-->
<!--
  The top inset sits on the ScrollView itself (M1): its job is to make this page's first row start
  where the AI page's first row starts. The AI page's list carries
  `miuix_preference_rv_padding_top` (7.27dp) above its leading text line and then its 35dp category
  header, so its first row lands at ~42.3dp. Here the leading line is this page's note, so the same
  ~42dp is made of: this 7dp inset (= their 7.27dp, rounded) + the note's 8dp top margin + its 14sp
  line (~19dp) + its 8dp bottom margin, and the note's margins are the very recipe their category
  header uses (8dp + 14sp + 8dp). Putting the whole 42dp here *instead* would push the first row to
  ~84dp — it is already spoken for by the note, which is why it is split this way.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="@dimen/provision_guide_list_top_inset">

    <!-- layout_gravity centres this block in the page: the guide's two rows leave a lot of the tall
         shell empty, and upstream's own five-row page did not have that problem. The ScrollView stays
         match_parent, so if the content ever outgrows the page it still scrolls (FrameLayout only
         applies gravity while the child is smaller than the viewport). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/miuix_theme_padding_horizontal_common">

        <TextView
            style="@style/ProvisionListSecondaryTextStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/miuix_theme_content_padding_horizontal_common"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:text="@string/provision_set_permission_later" />

        <com.sevtinge.hyperceiler.provision.widget.PermissionItemView
            android:id="@+id/accessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.sevtinge.hyperceiler.provision.widget.PermissionItemView
            android:id="@+id/overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />

    </LinearLayout>
</ScrollView>
