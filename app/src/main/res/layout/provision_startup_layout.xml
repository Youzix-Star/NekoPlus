<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.sevtinge.hyperceiler.provision.renderengine.RenderViewLayout
            android:id="@+id/render_view_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/background_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/miui_enter_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="30.0">

            <View
                android:id="@+id/show_qr_view"
                android:layout_width="@dimen/provision_qr_entrance_size"
                android:layout_height="@dimen/provision_qr_entrance_size"
                android:layout_alignParentEnd="true"
                android:contentDescription="@null"
                android:importantForAccessibility="no" />
        </RelativeLayout>

        <!--
          Branding: 上游这两个 view 是 HyperCeiler 的 logo / 字标 vector（文件仍留在 drawable 里，只是不再被引用）。
          90dp 这一格放本应用的文字标记 —— 常量 love.miao.yun.ui.AppIconText，在 Java 里设置，
          About 页用的也是它（launcher 图标里烤的是同一串）。盒子仍是它的 90dp、位置与入场动画不变；
          autoSize 只是让这个窄长（约 5:1）的标记始终填满 90dp 宽，而不是被省略号截掉。
        -->
        <TextView
            android:id="@+id/logo_image"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:layout_gravity="center"
            android:autoSizeMaxTextSize="40sp"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@android:color/white" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="40">

            <!--
              字标槽位（320x45.28dp，它的 dimens）：上游这里是 "HyperCeiler" 的白色字标 vector，
              现在是应用名；下面再加一行副标题，与 Compose 版引导首屏那三行（标记 / 应用名 /
              一句话）一致。容器由 FrameLayout 改成纵向 LinearLayout 只为了叠两行文字，
              尺寸、居中方式与它原来的写法相同。两行都在 logo_image_wrapper 里，
              所以上游那套入场动画（对 wrapper 整体做）一字未改地作用在它们身上。
            -->
            <LinearLayout
                android:id="@+id/logo_image_wrapper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_logo_image"
                    android:layout_width="@dimen/provision_startup_logo_width_thirteen"
                    android:layout_height="@dimen/provision_startup_logo_height_thirteen"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="@string/provision_guide_name"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/provision_title_text_size" />

                <TextView
                    android:id="@+id/text_logo_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/provision_subtitle_margin_top"
                    android:alpha="1"
                    android:shadowColor="#99000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="6"
                    android:text="@string/provision_guide_subtitle"
                    android:textColor="@color/provision_guide_subtitle_color"
                    android:textSize="@dimen/provision_subtitle_text_size" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/next_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:padding="4.5dp">

                <ImageButton
                    android:id="@+id/next"
                    android:layout_width="@dimen/provision_next_button_size"
                    android:layout_height="@dimen/provision_next_button_size"
                    android:clickable="false"
                    android:contentDescription="@string/provision_start_content_description"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/next_arrow"
                    android:layout_width="29dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:clickable="false"
                    android:contentDescription="@string/provision_start_content_description"
                    android:importantForAccessibility="no"
                    android:visibility="gone" />
            </FrameLayout>
        </RelativeLayout>

        <Space
            android:id="@+id/space_bottom"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="20" />

    </LinearLayout>
</FrameLayout>
