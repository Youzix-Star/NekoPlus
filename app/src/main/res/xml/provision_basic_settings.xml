<!--
  Upstream's BasicSettings page keeps its structure — a PreferenceCategory of rows, miuix
  preference rows, an icon on every row, the page's own title and preview icon — and lists the
  settings this app needs on a first run instead of HyperCeiler's own (language, launcher icon,
  scope). The keys are the app's AI keys; the fragment writes them through AiManager.

  EditTextPreference has to be spelled out in full: this inflater's default package is
  `fan.preference`, which has no EditTextPreference.
-->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="@string/provision_ai_category_endpoint">

        <androidx.preference.EditTextPreference
            android:key="base_url"
            android:title="@string/provision_ai_base_url" />

        <androidx.preference.EditTextPreference
            android:key="api_key"
            android:summary="@string/provision_ai_api_key_empty"
            android:title="@string/provision_ai_api_key" />

        <androidx.preference.EditTextPreference
            android:key="model"
            android:title="@string/provision_ai_model" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/provision_ai_category_connection">

        <Preference
            android:key="connection_test"
            android:summary="@string/provision_ai_test_summary"
            android:title="@string/provision_ai_test" />

    </PreferenceCategory>

</PreferenceScreen>
