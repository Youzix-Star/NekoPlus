<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- fan.miuix:* declares minSdk 33; the app targets 31 with graceful degradation. -->
    <uses-sdk
        tools:overrideLibrary="fan.animation,fan.appcompat,fan.basewidget,fan.bottomsheet,fan.cardview,fan.core,fan.folme,fan.navigator,fan.nestedheader,fan.pickerwidget,fan.preference,fan.recyclerview,fan.springback,fan.stretchablewidget,fan.theme,fan.transition,fan.viewpager2,fan.drawable,fan.widget,fan.text,fan.util,fan.graphics,fan.view" />

    <!-- 悬浮窗需要叠加层权限；前台服务让它在后台也能存活 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- AI 修改文本需要访问 OpenAI 兼容接口 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      miuix's preference rows and buttons fire a haptic tap in the background (MIUI's
      HapticFeedbackUtil through fan.utils.HapticFeedbackCompat). Without this permission that
      call throws SecurityException on a worker thread, which is an uncaught crash: it is what
      killed the guide the moment a row on the AI page was touched.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".MiaoApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.MiaoAssistant">

        <!--
          The crash report screen. `:crash` matters: the main process is dying when this opens, and
          the report has to outlive it. It draws itself with plain views and no theme resources, so
          it cannot fail the way the app just did.
        -->
        <activity
            android:name=".ui.crash.CrashReportActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:process=":crash"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.MiaoAssistant">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          无障碍服务：只在用户点悬浮窗按钮时读取 / 写回当前输入框。
          exported="true" 是官方文档给出的形式，实际入口由 BIND_ACCESSIBILITY_SERVICE
          保护，只有系统持有该权限。

          组件名伪装成系统自带的 select-to-speak 服务：微信 8.0.52+ 对不认识的无障碍服务会
          返回一棵空节点树（窗口在、根节点没有 class/bounds/子节点），换个组件名就绕过去了。
          真正的实现仍是 top.youzix.nekoplus.service.MiaoAccessibilityService，这里只声明这个壳 ——
          两个都声明会让系统设置里出现两条，也会把真名暴露给微信。
        -->
        <service
            android:name="com.google.android.accessibility.selecttospeak.SelectToSpeakService"
            android:enabled="true"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".service.FloatingWindowService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating_window" />
        </service>

        <!--
          新手引导 = HyperCeiler 的 library/provision 模块原样搬过来（AGPL-3.0-only）。
          四个页面串联成它自己的那条链：DefaultActivity（开场，自带 StartupFragment）
          → PermissionSettingsActivity（权限）→ BasicSettingsActivity（它自己的"应用设置"那一页，
          本应用用作 AI 配置）→ CongratulationActivity（完成，完成后回到 MainActivity）。
          Activity/Service 的声明与上游一致，只有两点不同：

          1. 上游全部 exported="true"（它的引导由 MIUI 引导框架从外部拉起，还带一个 MAIN
             intent-filter）。本应用的引导只由自己启动，所以设为 false，并去掉那个 filter；
          2. 主题是从上游 values/themes.xml 原样搬来的 @style/ProvisionTheme —
             它继承 miuix 的 Theme.AppCompat.DayNight，依赖已经加进来的 fan.miuix:* 包。

          ProvisionAnimService 是引导页"下一步/返回"动画的 AIDL 桩（上游同样 exported=false），
          由 fan.provision.ProvisionAnimHelper 用本应用包名绑定；没有它，权限页的按钮会走
          上游本来就有的直连分支，但动画回调链会断掉。
        -->
        <activity
            android:name="com.sevtinge.hyperceiler.provision.activity.DefaultActivity"
            android:exported="false"
            android:theme="@style/ProvisionTheme" />

        <activity
            android:name="com.sevtinge.hyperceiler.provision.activity.PermissionSettingsActivity"
            android:exported="false"
            android:theme="@style/ProvisionTheme" />

        <activity
            android:name="com.sevtinge.hyperceiler.provision.activity.BasicSettingsActivity"
            android:exported="false"
            android:theme="@style/ProvisionTheme" />

        <activity
            android:name="com.sevtinge.hyperceiler.provision.activity.CongratulationActivity"
            android:exported="false"
            android:theme="@style/ProvisionTheme" />

        <service
            android:name="com.sevtinge.hyperceiler.provision.service.ProvisionAnimService"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="fan.intent.action.OOBSERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

    </application>
</manifest>
